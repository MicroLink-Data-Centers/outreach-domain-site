# Cloudflare Pages _headers
# HTML must always be revalidated so the edge/browser never serve a stale page.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Static assets use unique filenames, so they can be cached long-term.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
